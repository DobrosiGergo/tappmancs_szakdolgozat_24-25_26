# Copy this file to .env and adjust the values:
#   cp .env.example .env
#
# This file holds the test accounts only. The address of the site comes from
# the Playwright config in use: playwright.config.ts runs against the local
# server, playwright.config.prod.ts against the deployed site.
#
# The values below are the accounts created by the seeder
# (app/database/seeders/UserSeeder.php), so they work on a freshly seeded
# database without changes. A variable exported in the shell overrides this file.

# Seeded regular user.
E2E_USER_EMAIL=user@example.com
E2E_USER_PASSWORD=RegularUserPassword123
E2E_USER_NAME=Regular User

# Seeded shelter owner.
E2E_OWNER_EMAIL=shelterowner@example.com
E2E_OWNER_PASSWORD=ShelterOwnerPassword123
E2E_OWNER_NAME=Shelter Owner

# Seeded shelter worker.
E2E_WORKER_EMAIL=shelterworker@example.com
E2E_WORKER_PASSWORD=ShelterWorkerPassword123
E2E_WORKER_NAME=Shelter Worker

# Password used for the accounts the mutating tests create.
E2E_NEW_USER_PASSWORD=E2eTestPassword123
