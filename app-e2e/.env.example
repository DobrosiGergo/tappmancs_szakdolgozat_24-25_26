# Copy this file to .env and adjust the values:
#   cp .env.example .env
#
# The defaults below match the local seeder (app/database/seeders/UserSeeder.php),
# so a freshly seeded local database works without any changes.
# Shell variables take precedence over this file.

# Which environment the suite runs against: local or production.
# In production mode the @mutating tests are skipped (npm run test:e2e:prod).
E2E_TARGET=local

# Base URL of the application under test.
E2E_BASE_URL=http://127.0.0.1:8000

# Seeded regular user.
E2E_USER_EMAIL=user@example.com
E2E_USER_PASSWORD=RegularUserPassword123
E2E_USER_NAME=Regular User

# Seeded shelter owner.
E2E_OWNER_EMAIL=shelterowner@example.com
E2E_OWNER_PASSWORD=ShelterOwnerPassword123
E2E_OWNER_NAME=Shelter Owner

# Seeded shelter worker.
E2E_WORKER_EMAIL=shelterworker@example.com
E2E_WORKER_PASSWORD=ShelterWorkerPassword123
E2E_WORKER_NAME=Shelter Worker

# Password used for the accounts the mutating tests create.
E2E_NEW_USER_PASSWORD=E2eTestPassword123
